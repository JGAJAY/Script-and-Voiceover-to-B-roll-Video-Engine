# ==============================================================================
# IncuBrix B-Roll Video Engine Configuration (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="IncuBrix B-Roll Video Engine"
APP_VERSION="1.0.0"
APP_ENV=production
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Storage & Public Download Links
STORAGE_TYPE=local            # "local" or "s3"
STORAGE_DIR=storage           # Root directory for local storage
BASE_URL=http://localhost:8000 # Base URL used for generated download URLs

# S3 / MinIO Configuration (used when STORAGE_TYPE=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=incubrix-videos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Security & Background Jobs
WEBHOOK_SECRET=incubrix-super-secret-hmac-key  # HMAC-SHA256 signature secret
MAX_CONCURRENT_JOBS=4

# Video Processing & Pacing Constraints
MAX_AUDIO_DURATION_SECONDS=600.0  # 10 minutes maximum duration
MIN_SCENE_DURATION_SECONDS=2.0    # Sensible pacing (avoids flashing <2s clips)
MAX_SCENE_DURATION_SECONDS=6.5
DEFAULT_VOICE=en-IN-female        # en-IN-female, hi-IN-female, ta-IN-female, en-US-female

# External Footage & AI APIs (Optional - Mock/Local providers active if empty)
PEXELS_API_KEY=                   # Optional Pexels API key for live stock search
PIXABAY_API_KEY=                  # Optional Pixabay API key
OPENAI_API_KEY=                   # Optional OpenAI API key
ENABLE_MOCK_SOURCES=true          # If true, runs 100% offline with zero external API keys

# FFmpeg Executable (Leave empty to auto-detect from imageio-ffmpeg or PATH)
FFMPEG_PATH=
